# GRIDIRON 2000 social-signal policy.
#
# These rules classify language, not truth. Every emitted signal remains
# provisional until the open statistics reconciliation lane confirms it.

rule CommunityDiscussionNoise priority 0 {
    when {
        source.evidence == "community_feed"
        and post.text matches ".*(what are we doing|ama |ask me anything|draft strategy|mock draft|rankings|rank these|tier list|sleepers|underrated|overrated|buy low|sell high|last .* years|season outlook).*"
    }
    then Ignore {
        reason: "general fantasy discussion rather than a current event",
    }
}

rule MarketSighting priority 0 {
    when {
        source.evidence == "market"
    }
    then Classify {
        category: "market",
        label: "MARKET SIGHTING",
        confidence: 0.52,
    }
}

rule Inactive priority 1 {
    when {
        post.text matches ".*(inactive|ruled out|will not play|won't play|not expected to play).*"
    }
    then Classify {
        category: "inactive",
        label: "INACTIVE",
        confidence: 0.82,
    }
}

