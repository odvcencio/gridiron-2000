# Gridiron 2000 -- Docker Compose quick-start settings.
#
# This is the MINIMAL first-run set, not the full reference. Every
# variable the app process itself reads lives in the repository root's
# .env.example; see docs/configuration.md for that complete list.
#
# Copy this file to .env next to compose.yaml, then edit .env:
#   cp .env.example .env

# -----------------------------------------------------------------------
# Compose orchestration only. Docker Compose reads these to build the
# service definitions; the app process itself never sees them, so they
# have no entry in the repository root's .env.example.
# -----------------------------------------------------------------------

# The pinned, published image. Leave this as-is to pull and run the last
# known-good release.
#
# To build your own image from this checkout instead, change this line to
# a plain local tag (Docker refuses to tag a build with someone else's
# digest) and build before you start the stack:
#   GRIDIRON_IMAGE=gridiron-2000:local
#   docker compose build app
GRIDIRON_IMAGE=harbor.draco.quest/orchard/gridiron-2000@sha256:ab646811af28b5abaf2135dc13c51cdd4a06ae307017a7a3407019afc30a3ab2

# Your public domain, used only by `docker compose --profile domain up -d`.
# Caddy requests its Let's Encrypt certificate for exactly this name, so
# point its DNS A/AAAA record at this server first. Leave empty for the
# localhost trial profile.
DOMAIN=

# Host port for the localhost trial profile only
# (`docker compose --profile localhost up -d`). Visit
# http://localhost:LOCALHOST_PORT once the container is up.
LOCALHOST_PORT=8080

# -----------------------------------------------------------------------
# App settings. Compose forwards these into the app container. Every
# name below also exists in the repository root's .env.example.
# -----------------------------------------------------------------------

APP_NAME="MY LEAGUE"

# Required. Generate one and paste it in:
#   openssl rand -base64 48
SESSION_SECRET=

# Leave both empty to try the app in demo mode: every visitor gets an
# open session with commissioner powers and there is no sign-in wall.
# That is fine for a private trial on your own machine; it is NOT fine
# for anything another person can reach. Setting APP_ENV=production
# below disables demo mode outright even if these stay empty, so a real
# league needs real values here before you flip APP_ENV.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match the callback URI registered on the Google OAuth
# client. Update it when you move from the localhost trial to a domain:
#   http://localhost:8080/auth/google/callback        (localhost trial)
#   https://your-domain.example/auth/google/callback   (domain profile)
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# One address per commissioner. Each one gets the /admin console.
COMMISSIONER_EMAILS=

# Optional comma-separated invite list. Empty means any signed-in Google
# account may claim an open seat.
LEAGUE_ALLOWED_EMAILS=

# See the demo-mode note above GOOGLE_CLIENT_ID. Set both of these
# before you put the league in front of real managers:
DEMO_MODE=true
APP_ENV=development

# -----------------------------------------------------------------------
# Optional: shared Tank01 relay for a host running more than one league
# (`docker compose --profile relay up -d`). Leave commented out to skip
# it -- the draft room still works on its embedded offline pool. See
# docs/quickstart.md's relay section for the exact two-variable setup
# this profile needs before you start it.
#
# On Tank01's free tier (1,000 requests/month, hard-limited), also set
# LIVE_PROFILE=free (app) and STATRELAY_PROFILE=free (this relay) in the
# repository root's .env.example for the slow-live cadence sized to stay
# under that limit -- see docs/season-operations.md's "Free-live profile"
# section for the request arithmetic.
# -----------------------------------------------------------------------
# TANK01_API_KEY=
