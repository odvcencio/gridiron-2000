APP_NAME="THE LEAGUE"
APP_ENV=development
PORT=8080
SESSION_SECRET=replace-with-at-least-32-random-characters

# Points at your own league.json: this project's identity surface (name,
# teams, divisions, draft date, invite copy — see config/league.json.example).
# Unset means the app looks for league.json at the app root, config/, or
# beside DATA_FILE, falling back to a neutral built-in reference league.
LEAGUE_FILE=

# Create a Google OAuth "Web application" client and register this exact URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Optional comma-separated invite list. Empty means any Google account may claim an open seat only when no membership domain is configured.
# Commissioners can also add invites at runtime from the /admin console.
LEAGUE_ALLOWED_EMAILS=

# Commissioner accounts for the /admin console (seat release, invites, resets).
# Demo mode opens the console to everyone for local rehearsal.
COMMISSIONER_EMAILS=

# Explicit authentication aliases for one real person, written as
# alias=canonical and separated by commas. This affects internal ownership,
# commissioner checks, sessions, and audit attribution. When the canonical
# identity is in COMMISSIONER_EMAILS, its explicit aliases are also admitted
# across the membership gate; unrelated identities still need raw policy.
# Example: IDENTITY_ALIASES=commissioner.alias@example.org=commissioner@example.com
IDENTITY_ALIASES=

# Commissioner identity is shared with the existing commissioner portfolio.
# The v1 provider below is a separate, read-only HMAC boundary on its own
# internal listener. Leave every COMMISSIONER_HQ_PROVIDER_* variable and
# COMMISSIONER_HQ_LEAGUE_ID unset to disable it. Setting any one opts in and
# requires the complete group. Never reuse COMMISSIONER_HQ_TOKEN here.
COMMISSIONER_INSTANCE_ID=local
# COMMISSIONER_HQ_LEAGUE_ID=
# COMMISSIONER_HQ_PROVIDER_KEY_ID=
# COMMISSIONER_HQ_PROVIDER_SECRET=
# COMMISSIONER_HQ_PROVIDER_SECRET_FILE=
# COMMISSIONER_HQ_PROVIDER_ADDR=:8091

# Optional HQ-host connection registry. Leave the variable absent to disable
# v1 fleet hosting. The JSON contains only safe topology and secret references;
# it never contains secret bytes. See config/commissioner-hq-v1.example.json.
# COMMISSIONER_HQ_V1_REGISTRY_FILE=/absolute/path/to/commissioner-hq-v1.json

# Optional immutable container digest reported by the v1 provider. Release
# tooling may inject it; empty keeps image_digest explicitly unknown.
APP_IMAGE_DIGEST=

# Draft instant, RFC3339. Also settable in league.json's draft.at (env
# wins). DRAFT_TZ sets the timezone the league room displays clock times in.
DRAFT_AT=
DRAFT_TZ=America/New_York

# Scoring edits freeze at this instant. Also settable in league.json's
# season_start_at (env wins).
SEASON_START_AT=

# The app is fully previewable without credentials. Set false when OAuth is configured for a real league.
DEMO_MODE=true

# No-key signal mesh. Four public RSS/Atom feeds are enabled by default; set
# WIRE_SOURCES_FILE to a JSON source list to replace those defaults. Bluesky is
# optional and should contain only commissioner-approved identities.
WIRE_ENABLED=true
WIRE_ROOT=data/signal-wire
WIRE_FEEDS_ENABLED=true
WIRE_SOURCES_FILE=
WIRE_FEED_INTERVAL=2m
WIRE_FEED_MAX_AGE=72h
WIRE_FEED_MAX_MB=4
BLUESKY_HANDLES=
BLUESKY_DIDS=
BLUESKY_JETSTREAM_URL=wss://jetstream2.us-west.bsky.network/subscribe
BLUESKY_RESOLVE_URL=https://public.api.bsky.app/xrpc/com.atproto.identity.resolveHandle
WIRE_RULES_FILE=
WIRE_TRUST_RULES_FILE=
WIRE_RECENT_LIMIT=1000
WIRE_RECONNECT_MIN=1s
WIRE_RECONNECT_MAX=30s
WIRE_REPLAY_WINDOW=24h

# CC-BY-4.0 schedules, injury reports, corrected weekly player statistics,
# team-week defense/special-teams box scores, and play-by-play from nflverse
# (team stats and play-by-play feed WP-R2's KICKING/DEFENSE/PUNTING scoring).
OPEN_STATS_ENABLED=true
OPEN_STATS_ROOT=data/open-stats
NFL_SEASON=2026
NFLVERSE_SCHEDULE_URL=https://github.com/nflverse/nflverse-data/releases/download/schedules/games.csv
NFLVERSE_PLAYER_STATS_URL=https://github.com/nflverse/nflverse-data/releases/download/stats_player/stats_player_week_2026.csv
NFLVERSE_INJURY_URL=https://github.com/nflverse/nflverse-data/releases/download/injuries/injuries_2026.csv
NFLVERSE_TEAM_STATS_URL=https://github.com/nflverse/nflverse-data/releases/download/stats_team/stats_team_week_2026.csv
NFLVERSE_PBP_URL=https://github.com/nflverse/nflverse-data/releases/download/pbp/play_by_play_2026.csv.gz
OPEN_STATS_SCHEDULE_INTERVAL=5m
OPEN_STATS_PLAYER_INTERVAL=6h
OPEN_STATS_INJURY_INTERVAL=15m
OPEN_STATS_TEAM_STATS_INTERVAL=6h
OPEN_STATS_PBP_INTERVAL=6h
OPEN_STATS_MAX_DOWNLOAD_MB=128

# Optional Tank01 (RapidAPI) fantasy data. Without a key the draft room uses
# an embedded offline pool with approximate ranks. With a key the pool syncs
# live ADP, projections, byes, and news. The free RapidAPI tier is enough:
# one sync costs five requests, and the app syncs every FANTASY_SYNC_INTERVAL.
# Point TANK01_HOST at another Tank01 sport host to reuse the client later.
TANK01_API_KEY=
TANK01_HOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com
SCORING_FORMAT=half_ppr
FANTASY_ROOT=data/fantasy
FANTASY_SYNC_INTERVAL=6h
FANTASY_POOL_LIMIT=400
FANTASY_MAX_DOWNLOAD_MB=32

# Regular-season live scoring (internal/livescore). LIVE_SCORING_ENABLED is
# the kill switch and defaults to false: with it off (or unset), Matchups
# reads the mirrored nflverse ledger only, exactly as before this feature.
# With it on, three layers fetch Tank01 through statrelay instead of one
# blanket per-game poll:
#   1. Scoreboard tick: one games-list call every LIVE_SCOREBOARD_INTERVAL,
#      only while a game is inside its own poll window (kickoff -5m..+5h);
#      an idle day costs zero calls.
#   2. Baseline: every in-progress game's box score is fetched at least
#      once per LIVE_BOX_BASELINE regardless of the scoreboard.
#   3. Wire trigger: a Touchdown/Turnover/BigPlay/KickingPlay signal
#      (internal/wire) naming a team with a game in progress fetches that
#      game's box at once, bounded to one triggered fetch per game per 10s.
#      This affects only fetch timing, never a stat or a score; a disabled
#      wire produces zero triggers.
# The live row wins while a player's game is in progress; the ledger row
# wins once final or whenever live has no data. LIVE_POLL_INTERVAL is the
# deprecated alias for LIVE_SCOREBOARD_INTERVAL — set the new name instead;
# the old one still works (with a startup log line) for a self-hosted
# instance, but no tracked deploy manifest sets it. LIVE_REPLAY_FIXTURE
# points at a recorded game's play-by-play directory for rehearsal/tests
# instead of polling Tank01; it replaces the league schedule with that one
# game, so a non-local APP_ENV refuses it unless
# LIVE_REPLAY_ALLOW_PRODUCTION=true.
LIVE_SCORING_ENABLED=false
LIVE_SCOREBOARD_INTERVAL=10s
LIVE_BOX_BASELINE=60s
LIVE_MAX_INFLIGHT=4
# 5000 box-score fetches/day/instance (a games-list call is never charged
# against this) — sized against the verified RapidAPI Tank01 Ultra quota:
# 15,000 requests/day, soft-limited (RapidAPI bills overage at
# $0.01/request instead of blocking, and returns no 429, so the app's own
# circuit breaker never fires on overage). STATRELAY_DAILY_BUDGET below is
# the real wallet guard; this leaves headroom for other instances and
# endpoints sharing the relay.
LIVE_DAILY_BUDGET=5000
LIVE_REPLAY_FIXTURE=
LIVE_REPLAY_STEP=2s
LIVE_REPLAY_ALLOW_PRODUCTION=false

# statrelay's own daily cap on relayed upstream Tank01 calls (cmd/statrelay),
# shared by every league instance behind it. 0 (the code default) means
# unlimited; the tracked deploy/k8s/statrelay.yaml sets 10000 against the
# verified Ultra quota above — this is the real wallet guard, since the
# relay never receives a 429 on overage either. Only meaningful on the
# relay's own deployment, not a league instance.
STATRELAY_DAILY_BUDGET=0
# In-progress getNFLBoxScore cache TTL on the relay, aligned with
# LIVE_SCOREBOARD_INTERVAL's default so the relay never serves a box score
# staler than the app's own fetch cadence. Only meaningful on the relay.
STATRELAY_BOX_LIVE_TTL=10s
# getNFLGamesForWeek cache TTL for the live regular-season scoreboard query
# (seasonType=reg) only; the preseason Blitz schedule query (seasonType=pre)
# keeps its own 24h TTL regardless of this value. Only meaningful on the
# relay.
STATRELAY_SCOREBOARD_TTL=10s

# Optional email for commissioner invites from /admin. Resend wins when both
# transports are set. Without either, the console still offers prefilled
# mail-app links and a copyable template.
RESEND_API_KEY=
RESEND_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Public address used inside invite emails. Also settable in league.json's
# league.url (env wins).
LEAGUE_URL=

# Required for reusable JSON, NDJSON, and CSV export endpoints.
DATA_API_TOKEN=

# Draft readiness, seat assignments, and picks persist here.
DATA_FILE=data/league-state.json
