APP_NAME="GRIDIRON 2000"
APP_ENV=development
PORT=8080
SESSION_SECRET=replace-with-at-least-32-random-characters

# Create a Google OAuth "Web application" client and register this exact URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Optional comma-separated invite list. Empty means any Google account may claim an open seat.
# Commissioners can also add invites at runtime from the /admin console.
LEAGUE_ALLOWED_EMAILS=

# Commissioner accounts for the /admin console (seat release, invites, resets).
# Demo mode opens the console to everyone for local rehearsal.
COMMISSIONER_EMAILS=

# Saturday, August 22, 2026 at 4:00 PM Eastern — kickoff of the Dolphins'
# second preseason game. Override with any RFC3339 timestamp. DRAFT_TZ sets
# the timezone the league room displays clock times in.
DRAFT_AT=2026-08-22T16:00:00-04:00
DRAFT_TZ=America/New_York

# Scoring edits freeze at this instant (NFL kickoff night by default).
SEASON_START_AT=2026-09-10T20:20:00-04:00

# The app is fully previewable without credentials. Set false when OAuth is configured for a real league.
DEMO_MODE=true

# No-key signal mesh. Four public RSS/Atom feeds are enabled by default; set
# WIRE_SOURCES_FILE to a JSON source list to replace those defaults. Bluesky is
# optional and should contain only commissioner-approved identities.
WIRE_ENABLED=true
WIRE_ROOT=data/signal-wire
WIRE_FEEDS_ENABLED=true
WIRE_SOURCES_FILE=
WIRE_FEED_INTERVAL=2m
WIRE_FEED_MAX_AGE=72h
WIRE_FEED_MAX_MB=4
BLUESKY_HANDLES=
BLUESKY_DIDS=
BLUESKY_JETSTREAM_URL=wss://jetstream2.us-west.bsky.network/subscribe
BLUESKY_RESOLVE_URL=https://public.api.bsky.app/xrpc/com.atproto.identity.resolveHandle
WIRE_RULES_FILE=
WIRE_TRUST_RULES_FILE=
WIRE_RECENT_LIMIT=1000
WIRE_RECONNECT_MIN=1s
WIRE_RECONNECT_MAX=30s
WIRE_REPLAY_WINDOW=24h

# CC-BY-4.0 schedules, injury reports, and corrected weekly player statistics from nflverse.
OPEN_STATS_ENABLED=true
OPEN_STATS_ROOT=data/open-stats
NFL_SEASON=2026
NFLVERSE_SCHEDULE_URL=https://github.com/nflverse/nflverse-data/releases/download/schedules/games.csv
NFLVERSE_PLAYER_STATS_URL=https://github.com/nflverse/nflverse-data/releases/download/stats_player/stats_player_week_2026.csv
NFLVERSE_INJURY_URL=https://github.com/nflverse/nflverse-data/releases/download/injuries/injuries_2026.csv
OPEN_STATS_SCHEDULE_INTERVAL=5m
OPEN_STATS_PLAYER_INTERVAL=6h
OPEN_STATS_INJURY_INTERVAL=15m
OPEN_STATS_MAX_DOWNLOAD_MB=128

# Optional Tank01 (RapidAPI) fantasy data. Without a key the draft room uses
# an embedded offline pool with approximate ranks. With a key the pool syncs
# live ADP, projections, byes, and news. The free RapidAPI tier is enough:
# one sync costs five requests, and the app syncs every FANTASY_SYNC_INTERVAL.
# Point TANK01_HOST at another Tank01 sport host to reuse the client later.
TANK01_API_KEY=
TANK01_HOST=tank01-nfl-live-in-game-real-time-statistics-nfl.p.rapidapi.com
SCORING_FORMAT=half_ppr
FANTASY_ROOT=data/fantasy
FANTASY_SYNC_INTERVAL=6h
FANTASY_POOL_LIMIT=400
FANTASY_MAX_DOWNLOAD_MB=32

# Required for reusable JSON, NDJSON, and CSV export endpoints.
DATA_API_TOKEN=

# Draft readiness, seat assignments, and picks persist here.
DATA_FILE=data/league-state.json
