package terms

func Page() Node {
	return <main class="legal-page" id="main-content">
		<span class="signal-label">
			<span class="live-dot" aria-hidden="true"></span>
			DOCUMENT // LEAGUE TERMS
		</span>
		<p class="page-kicker">Commissioner edition · 2026 season</p>
		<h1>
			HOUSE
			<br></br>
			RULES.
		</h1>
		<section>
			<h2>Private league use</h2>
			<p>
				This installation is intended for invited league managers. The commissioner controls membership, scoring configuration, curated public sources, and any final ruling when displayed data differs from a corrected game record.
			</p>
			<h2>Draft protocol</h2>
			<p>
				The default draft begins Saturday, August 15, 2026 at 5:00 PM Pacific and uses a fifteen-round snake order with ninety-second picks. Environment configuration may override those defaults.
			</p>
			<h2>Data accuracy</h2>
			<p>
				Demo rosters, projections, and matchup scores are illustrative. Publisher items, social dispatches, community tips, and market sightings are provisional and never award points. Source tiers and corroboration counts indicate provenance, not truth. The corrected open-stat ledger can be delayed, amended, or unavailable; the commissioner resolves any remaining dispute.
			</p>
			<h2>Fair play</h2>
			<p>
				Do not attempt to claim another manager’s seat, bypass server actions, submit deceptive sightings, scrape private member data, automate consumer-platform accounts, or interfere with the draft. Friendly trash talk remains subject to commissioner review.
			</p>
		</section>
		<a href="/" data-gosx-link class="button button--primary">Back to league HQ</a>
	</main>
}
